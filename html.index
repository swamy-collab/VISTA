
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#070b18">
<title>VISTA | Intelligence Meets Learning</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

:root{
 --bg:#070b18;
 --panel:#10182b;
 --blue:#55d5ff;
 --purple:#9a78ff;
 --white:#f4f6ff;
 --muted:#9caac4;
 --border:rgba(151,178,255,.16);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
 background:var(--bg);
 color:var(--white);
 font-family:Inter,Arial,sans-serif;
 overflow-x:hidden;
}
a{color:inherit;text-decoration:none}
button{font-family:inherit}
.background{
 position:fixed;inset:0;z-index:-2;
 background:
 radial-gradient(ellipse at 10% 15%,#12315b 0%,transparent 38%),
 radial-gradient(ellipse at 90% 40%,#291448 0%,transparent 35%),
 #070b18;
}
.grid-bg{
 position:fixed;inset:0;z-index:-1;pointer-events:none;
 opacity:.16;
 background-image:
 linear-gradient(rgba(110,160,255,.12) 1px,transparent 1px),
 linear-gradient(90deg,rgba(110,160,255,.12) 1px,transparent 1px);
 background-size:45px 45px;
 mask-image:linear-gradient(to bottom,black,transparent 85%);
}
nav{
 height:76px;padding:0 7%;
 display:flex;align-items:center;justify-content:space-between;
 position:sticky;top:0;z-index:20;
 background:#080d1de8;backdrop-filter:blur(20px);
 border-bottom:1px solid var(--border);
}
.brand{font-size:27px;font-weight:900;letter-spacing:3px}
.brand span{color:var(--blue)}
.navlinks{display:flex;gap:28px;align-items:center}
.navlinks a{font-size:13px;color:#c4cde1;transition:.2s}
.navlinks a:hover{color:var(--blue)}
.nav-cta,.primary{
 border:0;border-radius:9px;padding:13px 20px;
 color:white;font-weight:700;cursor:pointer;
 background:linear-gradient(110deg,#238dff,#8054ff);
 box-shadow:0 0 25px #536cff40;
}
.menu{display:none;background:none;color:white;border:0;font-size:25px}
.hero{
 min-height:690px;padding:90px 7% 75px;
 display:grid;grid-template-columns:1.15fr .85fr;
 align-items:center;gap:35px;
}
.pill{
 display:inline-flex;align-items:center;gap:9px;
 border:1px solid #4d80b7;padding:9px 14px;
 border-radius:40px;color:#a8ddff;font-size:11px;
 letter-spacing:1.5px;background:#12304a55;
}
.dot{width:7px;height:7px;background:#53e5bb;border-radius:50%;box-shadow:0 0 12px #53e5bb}
.hero h1{
 font-size:clamp(44px,6.5vw,76px);
 line-height:1.07;letter-spacing:-3px;margin:28px 0;
}
.gradient{
 background:linear-gradient(100deg,#55d5ff,#9a78ff,#e59aff);
 background-clip:text;-webkit-background-clip:text;color:transparent;
}
.hero p{color:var(--muted);font-size:16px;line-height:1.9;max-width:550px}
.actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:32px}
.secondary{
 padding:13px 20px;border:1px solid var(--border);
 background:#ffffff08;border-radius:9px;color:white;cursor:pointer;
}
.hero-note{margin-top:24px;font-size:11px;color:#788aa9}
.visual{display:flex;align-items:center;justify-content:center;position:relative;min-height:390px}
.orb{
 width:190px;height:190px;border-radius:50%;
 background:radial-gradient(circle at 35% 30%,#fff 0%,#73ddff 7%,#3978ff 28%,#6734bc 60%,#090d20 76%);
 box-shadow:0 0 35px #44caff90,0 0 100px #7951ff66,inset 0 0 30px white;
 animation:float 5s ease-in-out infinite;
 position:relative;
}
.orb:after{
 content:"";position:absolute;inset:-28px;
 border:1px solid #66caff77;border-radius:50%;
 box-shadow:0 0 35px #657eff33;
}
.orbit{
 position:absolute;width:330px;height:110px;
 border:1px solid #75aaff66;border-radius:50%;
 transform:rotate(-30deg);
 animation:spin 12s linear infinite;
}
.orbit.two{transform:rotate(55deg);animation-direction:reverse;width:300px}
@keyframes float{50%{transform:translateY(-16px) scale(1.04)}}
@keyframes spin{to{rotate:360deg}}
.float-card{
 position:absolute;background:#101c35eF;border:1px solid #6383bc55;
 padding:13px 17px;border-radius:12px;font-size:12px;
 box-shadow:0 12px 40px #0008;backdrop-filter:blur(12px);
}
.fc1{top:32px;right:0}.fc2{bottom:48px;left:0}
.section{padding:85px 7%}
.heading{text-align:center;margin-bottom:42px}
.heading h2{font-size:clamp(28px,4vw,42px);letter-spacing:-1px}
.heading p{color:var(--muted);margin-top:12px;font-size:14px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:19px}
.card{
 border:1px solid var(--border);background:linear-gradient(145deg,#151f36dd,#0c1428dd);
 border-radius:16px;padding:26px;transition:.3s;
}
.card:hover{transform:translateY(-6px);border-color:#54caff77;box-shadow:0 15px 40px #0005}
.card-icon{
 width:49px;height:49px;border-radius:13px;
 display:grid;place-items:center;font-size:24px;
 background:linear-gradient(135deg,#2367a855,#7946bb55);
 border:1px solid #6baaff44;
}
.card h3{font-size:17px;margin:19px 0 9px}
.card p{color:var(--muted);font-size:13px;line-height:1.8}
.workspace{
 max-width:900px;margin:auto;padding:30px;
 border:1px solid #42618c66;border-radius:19px;
 background:linear-gradient(145deg,#142440e8,#0c1428f5);
 box-shadow:0 20px 80px #0005;
}
.workspace-top{display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}
.workspace-top h3{font-size:20px}
.status{font-size:11px;color:#63e6b7}
.tabs{display:flex;gap:9px;flex-wrap:wrap;margin:27px 0}
.tab{
 padding:11px 16px;background:#ffffff08;border:1px solid var(--border);
 border-radius:9px;color:#b8c7df;cursor:pointer;font-size:13px;
}
.tab.active{background:#254c79;border-color:#56c9ff;color:white}
.panel{display:none}
.panel.active{display:block}
label{display:block;color:#c9d6eb;font-size:13px;margin:15px 0 8px}
input,textarea,select{
 width:100%;padding:14px;background:#080f20;
 border:1px solid #354c70;border-radius:9px;
 color:white;font:inherit;font-size:14px;
}
textarea{min-height:125px;resize:vertical}
input:focus,textarea:focus,select:focus{outline:1px solid var(--blue)}
.full{width:100%;margin-top:17px}
.output{
 display:none;margin-top:20px;padding:19px;
 border:1px solid #52caff66;background:#091b32;border-radius:12px;
 color:#dcecff;line-height:1.8;white-space:pre-wrap;font-size:14px;
}
.preview{max-width:100%;max-height:280px;margin-top:15px;border-radius:12px;display:none}
.mini-note{font-size:11px;color:var(--muted);margin-top:10px}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}
.step{text-align:center;padding:23px 12px}
.step-number{
 width:45px;height:45px;border:1px solid #5a9bdb;
 color:var(--blue);border-radius:50%;display:grid;place-items:center;
 margin:0 auto 15px;font-weight:800;
}
.quiz{max-width:620px;margin:auto}
.quiz button{
 display:block;width:100%;padding:14px;margin-top:12px;
 border:1px solid var(--border);border-radius:9px;
 background:#182844;color:white;cursor:pointer;text-align:left;
}
.quiz button:hover{border-color:var(--blue);background:#203b65}
#quizResult{margin-top:20px;color:var(--blue);font-size:14px}
footer{
 border-top:1px solid var(--border);padding:45px 7%;
 text-align:center;background:#080d19;
}
footer p{color:var(--muted);font-size:12px;margin-top:12px}
@media(max-width:800px){
 .hero{grid-template-columns:1fr;text-align:center;padding-top:65px}
 .hero p{margin:auto}
 .actions{justify-content:center}
 .visual{min-height:310px}
 .cards{grid-template-columns:1fr 1fr}
 .steps{grid-template-columns:1fr 1fr}
}
@media(max-width:520px){
 nav{padding:0 5%;height:68px}
 .menu{display:block}
 .navlinks{
  display:none;position:absolute;top:68px;left:0;width:100%;
  padding:20px;background:#0c1428;flex-direction:column;
  border-bottom:1px solid var(--border);
 }
 .navlinks.show{display:flex}
 .nav-cta{display:none}
 .hero h1{letter-spacing:-2px}
 .cards{grid-template-columns:1fr}
 .section{padding:65px 5%}
 .workspace{padding:19px}
 .float-card{font-size:10px}
}
</style>
</head>

<body>
<div class="background"></div>
<div class="grid-bg"></div>

<nav>
 <a class="brand" href="#home">VISTA<span>✦</span></a>
 <div class="navlinks" id="navlinks">
  <a href="#home">Home</a>
  <a href="#features">Discover</a>
  <a href="#learn">AI Workspace</a>
  <a href="#how">How it works</a>
  <a href="#quiz">Quiz</a>
 </div>
 <a href="#learn"><button class="nav-cta">Start Learning ↗</button></a>
 <button class="menu" onclick="toggleMenu()">☰</button>
</nav>

<main>
<section class="hero" id="home">
 <div>
  <div class="pill"><span class="dot"></span> THE FUTURE OF SMART EDUCATION</div>
  <h1>Learning is<br>evolving. <span class="gradient">Are you?</span></h1>
  <p>
   Discover a smarter way to understand the world.
   Transform complex concepts into visual experiences
   through text, images, voice and multilingual learning.
  </p>
  <div class="actions">
   <a href="#learn"><button class="primary">Explore VISTA →</button></a>
   <a href="#features"><button class="secondary">Discover Features</button></a>
  </div>
  <div class="hero-note">✦ VISUAL INTELLIGENCE FOR SMART TEACHING & AWARENESS</div>
 </div>
 <div class="visual">
  <div class="orbit"></div>
  <div class="orbit two"></div>
  <div class="orb"></div>
  <div class="float-card fc1">✧ AI LEARNING CORE</div>
  <div class="float-card fc2">◈ MULTILINGUAL LEARNING</div>
 </div>
</section>

<section class="section" id="features">
 <div class="heading">
  <h2>One Platform. <span class="gradient">Multiple Possibilities.</span></h2>
  <p>Knowledge should be experienced, not just memorized.</p>
 </div>
 <div class="cards">
  <div class="card">
   <div class="card-icon">◈</div>
   <h3>Visual Intelligence</h3>
   <p>Use images and visual explanations to make difficult topics easier to understand.</p>
  </div>
  <div class="card">
   <div class="card-icon">🎙</div>
   <h3>Voice Interaction</h3>
   <p>Ask questions naturally and explore learning through speech.</p>
  </div>
  <div class="card">
   <div class="card-icon">文</div>
   <h3>Multilingual Learning</h3>
   <p>Make education accessible through different Indian languages.</p>
  </div>
  <div class="card">
   <div class="card-icon">✦</div>
   <h3>Smart Explanations</h3>
   <p>Turn complicated subjects into simple, understandable learning experiences.</p>
  </div>
  <div class="card">
   <div class="card-icon">⚡</div>
   <h3>Interactive Quizzes</h3>
   <p>Test your understanding through fun knowledge challenges.</p>
  </div>
  <div class="card">
   <div class="card-icon">◎</div>
   <h3>Learn Anywhere</h3>
   <p>Explore learning from your phone, tablet or computer.</p>
  </div>
 </div>
</section>

<section class="section" id="learn">
 <div class="heading">
  <h2>Enter Your <span class="gradient">Learning Universe</span></h2>
  <p>Your learning journey begins with one question.</p>
 </div>

 <div class="workspace">
  <div class="workspace-top">
   <h3>✦ VISTA Learning Studio</h3>
   <span class="status">● PROTOTYPE ONLINE</span>
  </div>

  <label>Choose your language</label>
  <select id="language">
   <option value="English">English</option>
   <option value="Telugu">తెలుగు (Telugu)</option>
   <option value="Hindi">हिन्दी (Hindi)</option>
   <option value="Tamil">தமிழ் (Tamil)</option>
   <option value="Kannada">ಕನ್ನಡ (Kannada)</option>
   <option value="Malayalam">മലയാളം (Malayalam)</option>
   <option value="Bengali">বাংলা (Bengali)</option>
  </select>

  <div class="tabs">
   <button class="tab active" onclick="showTab('text',this)">✎ Text</button>
   <button class="tab" onclick="showTab('camera',this)">▧ Camera</button>
   <button class="tab" onclick="showTab('voice',this)">◉ Voice</button>
  </div>

  <div class="panel active" id="text">
   <label>What do you want to understand?</label>
   <textarea id="topic" placeholder="Example: Explain how artificial intelligence works..."></textarea>
   <button class="primary full" onclick="textDemo()">Start Learning →</button>
  </div>

  <div class="panel" id="camera">
   <label>Upload a learning image</label>
   <input type="file" id="imageInput" accept="image/*" capture="environment">
   <img class="preview" id="preview" alt="Your selected image">
   <p class="mini-note">Image preview works now. AI image analysis requires backend integration.</p>
  </div>

  <div class="panel" id="voice">
   <label>Speak your question</label>
   <button class="primary full" onclick="startVoice()">🎙 Activate Voice</button>
   <p class="mini-note" id="voiceStatus">Ready to listen. Microphone permission may be required.</p>
  </div>

  <div class="output" id="output"></div>
 </div>
</section>

<section class="section" id="how">
 <div class="heading">
  <h2>How VISTA <span class="gradient">Works</span></h2>
  <p>A simple journey from curiosity to understanding.</p>
 </div>
 <div class="steps">
  <div class="card step">
   <div class="step-number">01</div>
   <h3>Choose</h3>
   <p>Choose text, camera or voice.</p>
  </div>
  <div class="card step">
   <div class="step-number">02</div>
   <h3>Explore</h3>
   <p>Share the topic you want to understand.</p>
  </div>
  <div class="card step">
   <div class="step-number">03</div>
   <h3>Understand</h3>
   <p>Get visual and multilingual explanations.</p>
  </div>
  <div class="card step">
   <div class="step-number">04</div>
   <h3>Master</h3>
   <p>Practice through quizzes and games.</p>
  </div>
 </div>
</section>

<section class="section" id="quiz">
 <div class="heading">
  <h2>Challenge Your <span class="gradient">Brain</span></h2>
  <p>Every question is an opportunity to learn.</p>
 </div>
 <div class="card quiz">
  <div class="pill">KNOWLEDGE CHALLENGE · 01</div>
  <h3 style="margin-top:20px">Which planet is known as the Red Planet?</h3>
  <div id="answers">
   <button onclick="check(this,false)">A. Earth</button>
   <button onclick="check(this,true)">B. Mars</button>
   <button onclick="check(this,false)">C. Venus</button>
   <button onclick="check(this,false)">D. Jupiter</button>
  </div>
  <p id="quizResult"></p>
  <button class="secondary" style="margin-top:18px" onclick="resetQuiz()">Try Again ↻</button>
 </div>
</section>

<section class="section">
 <div class="card" style="text-align:center;padding:48px 20px">
  <div class="pill">A NEW WAY TO LEARN</div>
  <h2 style="font-size:clamp(28px,5vw,43px);margin:22px 0">
   Your curiosity.<br><span class="gradient">Our intelligence.</span>
  </h2>
  <p style="color:var(--muted)">See it. Understand it. Master it.</p>
  <a href="#learn"><button class="primary" style="margin-top:25px">Begin Your Journey →</button></a>
 </div>
</section>
</main>

<footer>
 <div class="brand">VISTA<span>✦</span></div>
 <p>Visual Intelligence for Smart Teaching & Awareness</p>
 <p>Making learning visual, interactive and accessible.</p>
 <p style="margin-top:25px">© 2026 VISTA. Built for the future of education.</p>
</footer>

<script>
function toggleMenu(){
 document.getElementById("navlinks").classList.toggle("show");
}
document.querySelectorAll(".navlinks a").forEach(a=>{
 a.addEventListener("click",()=>{
  document.getElementById("navlinks").classList.remove("show");
 });
});

function showTab(id,button){
 document.querySelectorAll(".panel").forEach(p=>p.classList.remove("active"));
 document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));
 document.getElementById(id).classList.add("active");
 button.classList.add("active");
 document.getElementById("output").style.display="none";
}

function showOutput(message){
 const out=document.getElementById("output");
 out.textContent=message;
 out.style.display="block";
 out.scrollIntoView({behavior:"smooth",block:"nearest"});
}

function textDemo(){
 const topic=document.getElementById("topic").value.trim();
 const lang=document.getElementById("language").value;
 if(!topic){alert("Please enter a topic.");return;}
 showOutput(
  "VISTA PROTOTYPE\n\n"+
  "Your topic: "+topic+
  "\nSelected language: "+lang+
  "\n\nYour learning request has been captured successfully.\n\n"+
  "AI explanation generation is not connected yet. Sarvam AI integration will power this feature in a future version."
 );
}

document.getElementById("imageInput").addEventListener("change",function(e){
 const file=e.target.files[0];
 if(!file)return;
 if(!file.type.startsWith("image/")){alert("Please select an image.");return;}
 const preview=document.getElementById("preview");
 if(preview.dataset.url)URL.revokeObjectURL(preview.dataset.url);
 const url=URL.createObjectURL(file);
 preview.src=url;
 preview.dataset.url=url;
 preview.style.display="block";
 showOutput("Image selected successfully: "+file.name+
 "\n\nImage preview is available. AI image recognition will be connected through the VISTA backend.");
});

function startVoice(){
 const Recognition=window.SpeechRecognition||window.webkitSpeechRecognition;
 if(!Recognition){
  document.getElementById("voiceStatus").textContent="Voice recognition is not supported in this browser. Try Chrome.";
  return;
 }
 const lang=document.getElementById("language").value;
 const r=new Recognition();
 r.lang=lang==="Telugu"?"te-IN":
 lang==="Hindi"?"hi-IN":
 lang==="Tamil"?"ta-IN":
 lang==="Kannada"?"kn-IN":
 lang==="Malayalam"?"ml-IN":
 lang==="Bengali"?"bn-IN":"en-IN";
 r.onstart=()=>document.getElementById("voiceStatus").textContent="Listening... Speak now.";
 r.onresult=e=>{
  const spoken=e.results[0][0].transcript;
  document.getElementById("voiceStatus").textContent="Recognized: "+spoken;
  document.getElementById("topic").value=spoken;
  showOutput("Voice input captured:\n"+spoken+
   "\n\nYour request is ready for future AI processing.");
 };
 r.onerror=()=>document.getElementById("voiceStatus").textContent="Could not recognize speech. Please try again.";
 r.onend=()=>{};
 r.start();
}

function check(button,correct){
 const result=document.getElementById("quizResult");
 document.querySelectorAll("#answers button").forEach(b=>b.disabled=true);
 if(correct){
  result.textContent="✓ Correct! Mars is called the Red Planet because of iron oxide on its surface.";
 }else{
  result.textContent="Not quite! The correct answer is Mars.";
 }
}
function resetQuiz(){
 document.querySelectorAll("#answers button").forEach(b=>b.disabled=false);
 document.getElementById("quizResult").textContent="";
}
</script>
</body>
</html>


  
  


